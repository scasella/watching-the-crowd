# Reference clone of SauersML/watching (clone it yourself: https://github.com/SauersML/watching)
ref_watching/

# Python / OS clutter
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
.DS_Store

# Model weights and raw tensor dumps. These live on the Modal volume `watching-batch-vol`
# (/vol/checkpoints, /vol/activations, /vol/results) and are regenerated by the scripts.
*.pt
*.pth
*.bin
*.safetensors
*.npy
*.npz

# A stale nested copy of the volume's /results directory (it also holds ~360 MB of raw
# per-token log-prob and layer-34 dumps). The flattened copies in results_watching_crowd/ are canonical.
results_watching_crowd/results/

# Duplicates: the scaled run's figures are the top-level figures/fig2-4; REPORT.md is in the repo root.
results_watching_crowd/figures/scaled/
results_watching_crowd/REPORT.md

# Modal run transcripts: they contain local paths and workspace-specific URLs. Every number
# they print is also written to the JSON files in results_watching_crowd/.
logs/

# Scratch files
File Paste*
image.png
*.tmp
